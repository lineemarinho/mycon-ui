{
  "name": "mycon-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=mycon-ui",
    "dev": "npm run dev --workspace=mycon-ui",
    "test": "npm run test --workspace=mycon-ui",
    "typecheck": "npm run typecheck --workspace=mycon-ui",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
